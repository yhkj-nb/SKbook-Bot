# SkBookBot 环境变量配置
# 复制此文件为 .env 并填写配置

# Web 管理面板配置
WEB_HOST=0.0.0.0
WEB_PORT=5200
WEB_SECRET_KEY=change-me-to-a-random-string
WEB_ADMIN_PASSWORD=admin123

# 默认 SkBook 机器人 Token（可在应用设置页获取）
BOT_TOKEN=

# 默认 OAuth2 配置
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=

# 数据库路径
DATA_DIR=./data